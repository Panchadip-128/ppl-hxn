# Copy to .env. Never commit your secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional expected seller ID; not required for single-merchant Standard Checkout.
# If set, a returned seller mismatch blocks capture/access. Never routes funds.
PAYPAL_MERCHANT_ID=
DATABASE_URL=sqlite:///instance/workshops.db
APP_ENV=development
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
PORT=8000

# Receipt scanning defaults to pinned, server-local Qwen assets. To use Ollama
# Cloud instead, configure one application-owned key on the server. Never accept
# or persist an end user's model key through the browser or an API route.
RECEIPT_VISION_PROVIDER=local_qwen
OLLAMA_API_KEY=
OLLAMA_VISION_MODEL=
